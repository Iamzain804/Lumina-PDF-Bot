# PDF Chatbot - Environment Configuration
# Copy this file to .env and add your actual API keys

# LLM Provider Selection (choose one: openrouter, groq, or openai)
LLM_PROVIDER=openrouter

# OpenRouter API Key (Get from: https://openrouter.ai/)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq API Key (Alternative - Get from: https://groq.com/)
# GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Alternative - Get from: https://platform.openai.com/)
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Model Configuration
# LLM_MODEL=llama-3.3-70b-versatile

# RAG Version — set to true to enable V2 semantic embeddings + FAISS
# Phase 2 default: false (TF-IDF)
# Phase 3 onwards: true (BGE embeddings + hybrid search)
# USE_V2_EMBEDDINGS=true